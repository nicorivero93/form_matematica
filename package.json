{
  "name": "form-matematicas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App educativa de Matemática — teoría, ejemplos paso a paso, visualizadores y quizzes para 4to grado primaria a último año de secundaria (NAP, Argentina).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run build && firebase deploy --only hosting --project form-matematica"
  },
  "dependencies": {
    "@sentry/react": "^8.42.0",
    "firebase": "^12.12.1",
    "framer-motion": "^11.15.0",
    "fuse.js": "^7.3.0",
    "katex": "^0.16.15",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
