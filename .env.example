# Sentry (opcional). Si está vacío la app igual funciona — Sentry no se inicializa.
VITE_SENTRY_DSN=

# Firebase (opcional). Si falta alguna clave la app sigue funcionando, solo no
# se reportan eventos a Analytics. Estas claves son públicas por design en
# Firebase web; conviene tenerlas centralizadas en .env.production igual.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
